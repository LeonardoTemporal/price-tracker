# ==========================================
# Backend Environment Variables
# ==========================================

# Secret key for JWT token generation
# IMPORTANT: Change this to a secure random string in production
SECRET_KEY=change-me-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URL
# For SQLite (development):
DATABASE_URL=sqlite:///./price_tracker.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/price_tracker

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Optional: Email service configuration for verification emails
# RESEND_API_KEY=your-resend-api-key

# Optional: Admin secret for administrative endpoints
# ADMIN_SECRET=your-admin-secret

# ==========================================
# Frontend Environment Variables
# ==========================================

# Backend API URL
VITE_API_URL=http://localhost:8000/api
